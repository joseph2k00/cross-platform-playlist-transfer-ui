# Base URL of the backend Spring Boot API.
VITE_API_BASE_URL=http://localhost:8080

# The redirect URI registered with Spotify/Google (must match backend config).
# The SPA runs on Vite's port; the backend redirects here with a `code`.
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback/spotify
VITE_YOUTUBE_REDIRECT_URI=http://localhost:5173/callback/youtube
